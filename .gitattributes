# Normalise line endings in the repository, check out native per platform.
* text=auto

# Rules below deliberately come after the wildcard: the last match wins.
# Batch files must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf

# Binary assets: never diff, never convert.
*.bin binary
*.pt  binary
*.whl binary
*.png binary
*.jpg binary

# The vendored upstream tree is not this project's code, so keep it out of the
# repository's language statistics -- otherwise GitHub labels the whole thing C.
llama2.c/** linguist-vendored

# include/prompts.h is machine-generated by scripts/gen_prompts.py, but it is
# committed so the project builds without running the generator first.
include/prompts.h linguist-generated
